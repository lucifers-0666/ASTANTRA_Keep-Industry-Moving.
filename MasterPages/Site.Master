<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="IndustrialSparePartPortal.MasterPages.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - SPAREFINDER</title>
    
    <!-- New SPAREFINDER design system -->
    <link href="<%= ResolveUrl("~/Content/css/tokens.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Content/css/base.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Content/css/components.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Content/css/animations.css") %>" rel="stylesheet" />

    <!-- Page specific sheets will be loaded by pages when required -->
    <link href="<%= ResolveUrl("~/Content/css/site-header.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Content/css/site-footer.css") %>" rel="stylesheet" />

    <!-- Legacy / fallback CSS (will be removed after migration) -->
    <link href="<%= ResolveUrl("~/css/site-header-enhanced.css") %>" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager runat="server"></asp:ScriptManager>
        <script src="<%= ResolveUrl("~/Content/js/ux-utils.js") %>"></script>

        <header class="sf-header" role="banner">
            <div class="sf-container sf-header-container">
                <a href="~/Default.aspx" runat="server" class="sf-brand">
                    <i class="fa-solid fa-gears"></i> SPAREFINDER <span class="sf-brand-tagline">Industrial Procurement</span>
                </a>

                <nav class="sf-nav-desktop" aria-label="Main Navigation">
                    <a id="navHome" href="~/Default.aspx" runat="server" class="sf-nav-link">Home</a>
                    <a id="navParts" href="~/Public/Parts.aspx" runat="server" class="sf-nav-link">Spare Parts</a>
                    <a id="navSuppliers" href="~/Public/Suppliers.aspx" runat="server" class="sf-nav-link">Suppliers</a>
                    <a id="navTechnicians" href="~/Public/Technicians.aspx" runat="server" class="sf-nav-link">Technicians</a>
                    <a id="navHowItWorks" href="~/Public/HowItWorks.aspx" runat="server" class="sf-nav-link">How It Works</a>
                    <a id="navWhyUs" href="~/Public/WhyUs.aspx" runat="server" class="sf-nav-link">Why Us</a>
                </nav>

                <div class="sf-nav-actions">
                    <a id="navEmergency" href="~/Public/Emergency.aspx" runat="server" class="sf-btn sf-btn-emergency" style="padding: 6px 12px; font-size: 12px;">
                        <i class="fa-solid fa-bolt"></i> Emergency Desk
                    </a>
                    <asp:PlaceHolder ID="phAnonymous" runat="server">
                        <a id="navLogin" href="~/Account/Login.aspx" runat="server" class="sf-nav-link">Sign In</a>
                        <a id="navRegister" href="~/Account/Register.aspx" runat="server" class="sf-btn sf-btn-primary" style="padding: 6px 12px; font-size: 12px;">Register</a>
                    </asp:PlaceHolder>
                    <asp:PlaceHolder ID="phAuthenticated" runat="server" Visible="false">
                        <a id="lnkDashboard" href="~/Default.aspx" runat="server" class="sf-btn sf-btn-primary" style="padding: 6px 12px; font-size: 12px;">Dashboard</a>
                        <a href="~/Account/Logout.aspx" runat="server" class="sf-nav-link" style="color: #dc2626;">Logout</a>
                    </asp:PlaceHolder>
                </div>

                <button type="button" id="btnMobileToggle" class="sf-mobile-toggle" aria-expanded="false">
                    <i class="fa-solid fa-bars" id="iconMenu"></i>
                </button>
            </div>
            
            <div id="mobileDrawer" class="sf-mobile-menu">
                <a id="navMobHome" href="~/Default.aspx" runat="server">Home</a>
                <a id="navMobParts" href="~/Public/Parts.aspx" runat="server">Spare Parts</a>
                <a id="navMobSuppliers" href="~/Public/Suppliers.aspx" runat="server">Suppliers</a>
                <a id="navMobTechnicians" href="~/Public/Technicians.aspx" runat="server">Technicians</a>
                <a id="navMobHowItWorks" href="~/Public/HowItWorks.aspx" runat="server">How It Works</a>
                <a id="navMobWhyUs" href="~/Public/WhyUs.aspx" runat="server">Why Us</a>
                <a id="navMobEmergency" href="~/Public/Emergency.aspx" runat="server" style="color: var(--sf-emergency);"><i class="fa-solid fa-bolt"></i> Emergency Desk</a>
                <div style="border-top: 1px solid var(--sf-border); margin-top: 12px; padding-top: 12px;">
                    <a href="~/Account/Login.aspx" runat="server">Sign In</a>
                    <a href="~/Account/Register.aspx" runat="server" style="color: var(--sf-primary);">Register</a>
                </div>
            </div>
        </header>

        <div id="mobileDrawerBackdrop" class="sf-backdrop"></div>

        <main role="main" class="flex-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </main>

        <asp:PlaceHolder ID="phPreFooterEmergency" runat="server">
            <section style="background: var(--sf-surface); border-top: 1px solid var(--sf-border); border-bottom: 1px solid var(--sf-border); padding: 48px 0;">
                <div class="sf-container" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px;">
                    <div>
                        <div style="color: var(--sf-emergency); font-size: 12px; font-weight: 700; margin-bottom: 8px;"><i class="fa-solid fa-bolt"></i> EMERGENCY PROTOCOL</div>
                        <h3 style="font-size: 20px; color: var(--sf-text); margin: 0 0 8px 0;">Critical machine stopped on your plant floor?</h3>
                        <p style="margin: 0; max-width: 600px;">Broadcast urgent OEM replacement requirements across regional verified stockists and on-call field technicians.</p>
                    </div>
                    <a href="~/Public/Emergency.aspx" runat="server" class="sf-btn sf-btn-emergency">Submit Breakdown Alert</a>
                </div>
            </section>
        </asp:PlaceHolder>

        <footer class="sf-footer">
            <div class="sf-container">
                <div class="sf-footer-grid">
                    <div>
                        <div class="sf-footer-brand"><i class="fa-solid fa-gears"></i> SPAREFINDER</div>
                        <p class="sf-footer-desc">B2B platform for industrial spare-part discovery, multi-supplier quotation comparison, breakdown alerts, and certified field technician dispatch.</p>
                    </div>
                    <div>
                        <h4 class="sf-footer-heading">Sourcing</h4>
                        <ul class="sf-footer-links">
                            <li><a href="~/Public/Parts.aspx" runat="server">Spare Parts Catalog</a></li>
                            <li><a href="~/Public/Suppliers.aspx" runat="server">Verified Suppliers</a></li>
                            <li><a href="~/Public/Emergency.aspx" runat="server"><i class="fa-solid fa-bolt"></i> Emergency Desk</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="sf-footer-heading">Services</h4>
                        <ul class="sf-footer-links">
                            <li><a href="~/Public/Technicians.aspx" runat="server">Field Technicians</a></li>
                            <li><a href="~/Public/HowItWorks.aspx" runat="server">How It Works</a></li>
                            <li><a href="~/Public/WhyUs.aspx" runat="server">Why Us</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="sf-footer-heading">Workspace</h4>
                        <ul class="sf-footer-links">
                            <li><a href="~/Account/Login.aspx" runat="server">Sign In</a></li>
                            <li><a href="~/Account/Register.aspx" runat="server">Register Entity</a></li>
                        </ul>
                    </div>
                </div>
                <div class="sf-footer-bottom">
                    <div class="sf-footer-copy">&copy; <%: DateTime.Now.Year %> SPAREFINDER &middot; MCA Project Demonstration</div>
                    <div class="sf-footer-mca">ASP.NET Web Forms &middot; C# &middot; SQL Server &middot; ADO.NET</div>
                </div>
            </div>
        </footer>
    </form>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const btn = document.getElementById('btnMobileToggle');
            const menu = document.getElementById('mobileDrawer');
            const backdrop = document.getElementById('mobileDrawerBackdrop');
            const icon = document.getElementById('iconMenu');

            if(btn && menu && backdrop) {
                const toggleMenu = () => {
                    const isOpen = menu.classList.contains('open');
                    if (isOpen) {
                        menu.classList.remove('open');
                        backdrop.classList.remove('open');
                        btn.setAttribute('aria-expanded', 'false');
                        icon.classList.remove('fa-xmark');
                        icon.classList.add('fa-bars');
                    } else {
                        menu.classList.add('open');
                        backdrop.classList.add('open');
                        btn.setAttribute('aria-expanded', 'true');
                        icon.classList.remove('fa-bars');
                        icon.classList.add('fa-xmark');
                    }
                };
                btn.addEventListener('click', toggleMenu);
                backdrop.addEventListener('click', toggleMenu);
            }
        });
    </script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
