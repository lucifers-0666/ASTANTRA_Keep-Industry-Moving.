<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="IndustrialSparePartPortal.MasterPages.SiteMaster" %>

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#F8FAFC]">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - SPAREFINDER Industrial Procurement Network</title>
    
    <!-- Compiled Tailwind CSS & Industrial Design System -->
    <link href="<%= ResolveUrl("~/Content/css/site.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/site-shell.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    
    <!-- Modular Industrial Design System (BEM) -->
    <link href="<%= ResolveUrl("~/css/variables.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/css/base.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/css/layout.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/css/components/buttons.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/css/components/forms.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/css/components/cards.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/css/components/badges.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/css/animations.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Google Fonts Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="h-full flex flex-col font-['Inter',sans-serif] antialiased text-[#0F172A] bg-[#F8FAFC]">
    <form id="form1" runat="server" class="flex flex-col min-h-full">

        <!-- ============================================================================ -->
        <!-- AUTHORITATIVE FIXED MASTER HEADER (.site-header)                             -->
        <!-- Permanent viewport visibility, zero jump, route-aware active indicators      -->
        <!-- ============================================================================ -->
        <header id="headerWrapper" class="site-header" role="banner">
            <div class="site-header-inner">
                
                <!-- Brand Identity -->
                <a href="~/Default.aspx" runat="server" class="site-brand" aria-label="SPAREFINDER Home">
                    <div class="site-brand-icon">
                        <i class="fa-solid fa-gears text-sm"></i>
                    </div>
                    <div class="site-brand-text">
                        <span class="site-brand-title">SPARE<span>FINDER</span></span>
                        <span class="site-brand-sub">Procurement Network</span>
                    </div>
                </a>

                <!-- Desktop Primary Navigation with Route-Aware Active Indicators -->
                <nav class="site-desktop-nav" aria-label="Main Navigation">
                    <a id="navHome" href="~/Default.aspx" runat="server" class="site-nav-link">Home</a>
                    <a id="navParts" href="~/Public/Parts.aspx" runat="server" class="site-nav-link">Spare Parts</a>
                    <a id="navSuppliers" href="~/Public/Suppliers.aspx" runat="server" class="site-nav-link">Suppliers</a>
                    <a id="navTechnicians" href="~/Public/Technicians.aspx" runat="server" class="site-nav-link">Technicians</a>
                    <a id="navHowItWorks" href="~/Public/HowItWorks.aspx" runat="server" class="site-nav-link">How It Works</a>
                    <a id="navWhyUs" href="~/Public/WhyUs.aspx" runat="server" class="site-nav-link">Why Us</a>
                    <a id="navEmergency" href="~/Public/Emergency.aspx" runat="server" class="site-nav-link site-nav-link-emergency">
                        <i class="fa-solid fa-bolt text-xs"></i> Emergency Desk
                    </a>
                </nav>

                <!-- Action Controls: Workspace Authentication -->
                <div class="site-header-actions">
                    <asp:PlaceHolder ID="phAnonymous" runat="server">
                        <a id="navLogin" href="~/Account/Login.aspx" runat="server" class="site-btn-signin">
                            Sign In
                        </a>
                        <a id="navRegister" href="~/Account/Register.aspx" runat="server" class="btn-primary text-xs py-2 px-3.5 font-bold shadow-xs">
                            <i class="fa-solid fa-user-plus text-xs"></i> Register
                        </a>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phAuthenticated" runat="server" Visible="false">
                        <a id="lnkDashboard" runat="server" href="#" class="btn-secondary text-xs py-2 px-3 font-bold">
                            <i class="fa-solid fa-gauge-high text-xs"></i> Workspace
                        </a>
                        <a href="~/Account/Logout.aspx" runat="server" class="text-xs text-red-400 hover:text-red-300 font-bold px-2 py-1 transition-colors">Logout</a>
                    </asp:PlaceHolder>
                </div>

                <!-- Mobile Menu Hamburger Button (< 1024px) -->
                <button type="button" id="btnMobileToggle" class="site-mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobileDrawer">
                    <i class="fa-solid fa-bars" id="iconMenu"></i>
                </button>

            </div>

            <!-- Mobile Navigation Drawer Overlay (< 1024px) -->
            <div id="mobileDrawer" class="site-mobile-menu" aria-label="Mobile Navigation">
                <nav class="flex flex-col space-y-1 text-sm font-semibold text-[#0F172A]">
                    <a id="navMobHome" href="~/Default.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">Home</a>
                    <a id="navMobParts" href="~/Public/Parts.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">Spare Parts Catalog</a>
                    <a id="navMobSuppliers" href="~/Public/Suppliers.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">Supplier Directory</a>
                    <a id="navMobTechnicians" href="~/Public/Technicians.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">Field Technicians</a>
                    <a id="navMobHowItWorks" href="~/Public/HowItWorks.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">How It Works</a>
                    <a id="navMobWhyUs" href="~/Public/WhyUs.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">Platform Comparison</a>
                    <a id="navMobEmergency" href="~/Public/Emergency.aspx" runat="server" class="px-3.5 py-2.5 rounded-lg bg-orange-50 text-[#EA580C] font-bold border border-orange-200 mt-1">
                        <i class="fa-solid fa-bolt mr-2"></i> Emergency Breakdown Desk
                    </a>
                </nav>

                <div class="pt-4 mt-4 border-t border-[#CBD5E1] flex flex-col gap-2.5">
                    <a href="~/Account/Login.aspx" runat="server" class="btn-secondary w-full justify-center text-xs py-2.5 font-bold">Sign In to Account</a>
                    <a href="~/Account/Register.aspx" runat="server" class="btn-primary w-full justify-center text-xs py-2.5 font-bold">Register Portal Account</a>
                </div>
            </div>
        </header>

        <!-- Mobile Drawer Backdrop Overlay -->
        <div id="mobileDrawerBackdrop" class="site-mobile-backdrop"></div>

        <!-- ============================================================================ -->
        <!-- MAIN CONTENT AREA                                                            -->
        <!-- ============================================================================ -->
        <main class="flex-1" role="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- ============================================================================ -->
        <!-- CONTEXTUAL PRE-FOOTER EMERGENCY CALLOUT                                      -->
        <!-- Shown on high-level discovery pages (Home, Why Us); suppressed on Login/Reg  -->
        <!-- ============================================================================ -->
        <asp:PlaceHolder ID="phPreFooterEmergency" runat="server">
            <section class="bg-gradient-to-r from-orange-50 via-white to-amber-50 border-t border-b border-[#CBD5E1] py-10 px-4 sm:px-6 lg:px-8">
                <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                    <div class="space-y-1.5 max-w-2xl text-left">
                        <div class="flex items-center gap-2">
                            <span class="spec-tag spec-tag-orange"><i class="fa-solid fa-bolt"></i> EMERGENCY PROTOCOL</span>
                            <span class="text-xs text-[#64748B] font-mono">CRITICAL DOWNTIME SOURCING</span>
                        </div>
                        <h3 class="text-xl font-bold text-[#0F172A] m-0">Critical machine stopped on your plant floor?</h3>
                        <p class="text-xs sm:text-sm text-[#475569] m-0 leading-relaxed">
                            Broadcast urgent OEM replacement requirements across regional verified stockists and on-call field technicians.
                        </p>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                        <a href="~/Public/Emergency.aspx" runat="server" class="btn-emergency text-xs py-2.5 px-5 font-bold shadow-xs whitespace-nowrap">
                            <i class="fa-solid fa-triangle-exclamation mr-1.5"></i> Submit Breakdown Alert
                        </a>
                    </div>
                </div>
            </section>
        </asp:PlaceHolder>

        <!-- ============================================================================ -->
        <!-- REDESIGNED CONCISE PUBLIC FOOTER (#0F172A)                                   -->
        <!-- Concise 3-column architecture, honest academic disclosure, clean hierarchy   -->
        <!-- ============================================================================ -->
        <footer id="siteFooter" class="site-footer" role="contentinfo">
            <div class="site-footer-container">
                <div class="site-footer-main">
                    
                    <!-- Column 1: Brand & Project Context (Spans 2 columns on desktop) -->
                    <div class="site-footer-brand-col">
                        <div class="site-footer-brand">
                            <div class="site-footer-brand-icon">
                                <i class="fa-solid fa-gears"></i>
                            </div>
                            <div>
                                <span class="site-footer-brand-title">SPARE<span>FINDER</span></span>
                                <span class="site-footer-brand-tagline">B2B Industrial Procurement Network</span>
                            </div>
                        </div>
                        <p class="site-footer-desc">
                            Academic demonstration platform for industrial spare-part discovery, multi-supplier quotation comparison, breakdown alerts, and certified field technician dispatch.
                        </p>
                        <div class="site-footer-badges">
                            <span class="site-footer-badge">MCA Project Prototype</span>
                            <span class="site-footer-badge site-footer-badge-amber">ASP.NET Web Forms</span>
                        </div>
                    </div>

                    <!-- Column 2: Spare Parts & Sourcing -->
                    <div class="site-footer-col">
                        <h4 class="site-footer-heading">
                            <i class="fa-solid fa-layer-group text-[#38BDF8] text-[10px]"></i> Sourcing
                        </h4>
                        <ul class="site-footer-links">
                            <li><a href="~/Public/Parts.aspx" runat="server">Spare-Parts Catalog</a></li>
                            <li><a href="~/Public/Suppliers.aspx" runat="server">Verified Suppliers</a></li>
                            <li><a href="~/Public/Emergency.aspx" runat="server" class="site-footer-emergency-link">
                                <i class="fa-solid fa-bolt text-[10px]"></i> Emergency Desk
                            </a></li>
                        </ul>
                    </div>

                    <!-- Column 3: Platform & Workflow -->
                    <div class="site-footer-col">
                        <h4 class="site-footer-heading">
                            <i class="fa-solid fa-compass text-emerald-400 text-[10px]"></i> Services
                        </h4>
                        <ul class="site-footer-links">
                            <li><a href="~/Public/Technicians.aspx" runat="server">Field Technicians</a></li>
                            <li><a href="~/Public/HowItWorks.aspx" runat="server">Procurement Flow</a></li>
                            <li><a href="~/Public/WhyUs.aspx" runat="server">Platform Comparison</a></li>
                        </ul>
                    </div>

                    <!-- Column 4: Account Access -->
                    <div class="site-footer-col">
                        <h4 class="site-footer-heading">
                            <i class="fa-solid fa-user-lock text-purple-400 text-[10px]"></i> Workspace
                        </h4>
                        <ul class="site-footer-links">
                            <li><a href="~/Account/Login.aspx" runat="server">Portal Sign In</a></li>
                            <li><a href="~/Account/Register.aspx" runat="server">Register Entity</a></li>
                        </ul>
                    </div>

                </div>

                <!-- Footer Bottom Disclaimer & Technical Stack -->
                <div class="site-footer-bottom">
                    <p class="m-0">
                        &copy; <%: DateTime.Now.Year %> SPAREFINDER &middot; Master of Computer Applications (MCA) Project Demonstration
                    </p>
                    <p class="site-footer-academic m-0">
                        Simulated demonstration data &middot; ASP.NET Web Forms &middot; C# &middot; SQL Server &middot; ADO.NET
                    </p>
                </div>
            </div>
        </footer>
    </form>

    <!-- Public Shell JavaScript -->
    <script src="<%= ResolveUrl("~/Content/js/site-shell.js") %>?v=<%= DateTime.Now.Ticks %>"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>

