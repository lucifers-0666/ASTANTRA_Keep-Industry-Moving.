<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Factory.Master.cs" Inherits="IndustrialSparePartPortal.MasterPages.FactoryMaster" %>

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#F8FAFC]">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - ASTANTRA Factory Workspace</title>
    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/svg+xml" href="<%= ResolveUrl("~/Content/images/brand/favicon.svg") %>" />
    <link rel="alternate icon" href="<%= ResolveUrl("~/favicon.ico") %>" />
    <link rel="icon" type="image/png" sizes="32x32" href="<%= ResolveUrl("~/Content/images/brand/favicon-32.png") %>" />
    <link rel="icon" type="image/png" sizes="16x16" href="<%= ResolveUrl("~/Content/images/brand/favicon-16.png") %>" />
    <link rel="apple-touch-icon" sizes="180x180" href="<%= ResolveUrl("~/Content/images/brand/apple-touch-icon.png") %>" />
    <link href="~/Content/css/site.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/site-shell.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="h-full flex flex-col font-['Inter',sans-serif] antialiased text-[#0F172A] bg-[#F8FAFC]">
    <form id="form1" runat="server" class="flex flex-col min-h-full">
        
        <!-- Factory Authoritative Header -->
        <header class="site-header" role="banner">
            <div class="site-header-inner">
                <!-- Brand Logo -->
                <div class="flex items-center gap-3">
                    <a href="~/Factory/Dashboard.aspx" runat="server" class="site-brand">
                        <div class="site-brand-icon">
                            <i class="fa-solid fa-industry text-sm"></i>
                        </div>
                        <div class="site-brand-text">
                            <span class="site-brand-title">FACTORY<span>WORKSPACE</span></span>
                            <span class="site-brand-sub">Industrial Buyer Console</span>
                        </div>
                    </a>
                </div>

                <!-- Navigation Links -->
                <nav class="site-desktop-nav">
                    <a href="~/Factory/Dashboard.aspx" runat="server" class="site-nav-link">Dashboard</a>
                    <a href="~/Public/Parts.aspx" runat="server" class="site-nav-link">Find Spare Parts</a>
                    <a href="~/Public/Emergency.aspx" runat="server" class="site-nav-link site-nav-link-emergency">
                        <i class="fa-solid fa-bolt text-xs"></i> Emergency Breakdown
                    </a>
                    <a href="~/Public/Suppliers.aspx" runat="server" class="site-nav-link">Suppliers</a>
                    <a href="~/Public/Technicians.aspx" runat="server" class="site-nav-link">Technicians</a>
                </nav>

                <!-- Profile & Account Info -->
                <div class="site-header-actions">
                    <div class="hidden sm:flex flex-col text-right">
                        <span class="text-xs font-bold text-[#0F172A]" id="lblFactoryName" runat="server">Industrial Buyer</span>
                        <span class="spec-tag spec-tag-emerald text-[9px]"><i class="fa-solid fa-circle-check text-[7px]"></i> VERIFIED BUYER</span>
                    </div>
                    <a href="~/Account/Logout.aspx" runat="server" class="btn-secondary text-xs py-1.5 px-3 font-bold text-red-600 hover:text-red-700">
                        <i class="fa-solid fa-right-from-bracket mr-1"></i> Logout
                    </a>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8" role="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-[#CBD5E1] py-4 text-xs text-[#64748B] mt-auto">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-2">
                <p class="m-0">&copy; <%: DateTime.Now.Year %> ASTANTRA &middot; Factory Buyer Console</p>
                <div class="flex items-center gap-4 text-xs">
                    <a href="~/Public/WhyUs.aspx" runat="server" class="hover:text-[#1D4ED8]">Platform Differentiators</a>
                    <a href="~/Public/Emergency.aspx" runat="server" class="text-[#EA580C] font-bold">Emergency Protocol</a>
                </div>
            </div>
        </footer>
    </form>
    <script src="<%= ResolveUrl("~/Content/js/site-shell.js") %>?v=<%= DateTime.Now.Ticks %>"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>

