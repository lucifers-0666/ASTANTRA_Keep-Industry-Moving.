<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="IndustrialSparePartPortal.MasterPages.AdminMaster" %>

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#F1F5F9]">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - ASTANTRA Administrator Console</title>
    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/svg+xml" href="<%= ResolveUrl("~/Content/images/brand/favicon.svg") %>" />
    <link rel="alternate icon" href="<%= ResolveUrl("~/favicon.ico") %>" />
    <link rel="icon" type="image/png" sizes="32x32" href="<%= ResolveUrl("~/Content/images/brand/favicon-32.png") %>" />
    <link rel="icon" type="image/png" sizes="16x16" href="<%= ResolveUrl("~/Content/images/brand/favicon-16.png") %>" />
    <link rel="apple-touch-icon" sizes="180x180" href="<%= ResolveUrl("~/Content/images/brand/apple-touch-icon.png") %>" />
    <!-- Core & Shell CSS -->
    <link href="<%= ResolveUrl("~/Content/css/site.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/site-shell.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveUrl("~/Content/css/admin.css") %>?v=<%= DateTime.Now.Ticks %>" rel="stylesheet" type="text/css" />
    <!-- Icons and Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="h-full font-['IBM_Plex_Sans',sans-serif] antialiased text-[#0F172A] bg-[#F1F5F9] flex overflow-hidden">
    <form id="form1" runat="server" class="flex w-full h-full">
        <!-- Sidebar Navigation (Authoritative Dark) -->
        <aside class="w-64 bg-[#0F172A] text-slate-300 flex flex-col shrink-0 border-r border-slate-800 shadow-xl select-none">
            <!-- Brand header -->
            <div class="h-16 px-5 flex items-center justify-between border-b border-slate-800 bg-[#0B1120]">
                <a href="~/Admin/Dashboard.aspx" runat="server" class="flex items-center gap-3 no-underline">
                    <div class="w-8 h-8 rounded bg-[#1769E0] flex items-center justify-center text-white font-black text-sm shadow-sm">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div class="flex flex-col text-left">
                        <span class="text-sm font-black font-['Archivo',sans-serif] tracking-wider text-white">ASTANTRA</span>
                        <span class="text-[9px] font-mono tracking-widest text-[#38BDF8] uppercase font-bold">ADMIN CONSOLE</span>
                    </div>
                </a>
            </div>

            <!-- Sidebar Links Menu -->
            <nav class="flex-1 px-3 py-5 space-y-1 overflow-y-auto text-left">
                <!-- Group 1: Executive Dashboard -->
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-3 mb-1 font-mono">Executive Console</div>
                <a href="~/Admin/Dashboard.aspx" runat="server" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded text-slate-200 hover:bg-[#1E293B] hover:text-white transition-colors">
                    <i class="fa-solid fa-chart-line w-4 text-center text-[#38BDF8]"></i> Command Dashboard
                </a>

                <!-- Group 2: User Governance & RBAC -->
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-3 mt-4 mb-1 font-mono">Platform Roster &amp; RBAC</div>
                <a href="~/Admin/Users/ManageUsers.aspx" runat="server" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded text-slate-300 hover:bg-[#1E293B] hover:text-white transition-colors">
                    <i class="fa-solid fa-users-gear w-4 text-center text-blue-400"></i> System User Directory
                </a>
                <a href="~/Admin/Factories/ManageFactories.aspx" runat="server" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded text-slate-300 hover:bg-[#1E293B] hover:text-white transition-colors">
                    <i class="fa-solid fa-industry w-4 text-center text-amber-400"></i> Industrial Plant Buyers
                </a>
                <a href="~/Admin/Suppliers/Verification.aspx" runat="server" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded text-slate-300 hover:bg-[#1E293B] hover:text-white transition-colors">
                    <i class="fa-solid fa-warehouse w-4 text-center text-emerald-400"></i> Suppliers &amp; Verification
                </a>
                <a href="~/Admin/Technicians/ManageTechnicians.aspx" runat="server" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded text-slate-300 hover:bg-[#1E293B] hover:text-white transition-colors">
                    <i class="fa-solid fa-user-wrench w-4 text-center text-cyan-400"></i> Service Technicians
                </a>

                <!-- Group 3: Catalog & Machinery Registry -->
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-3 mt-4 mb-1 font-mono">Catalog &amp; Machinery</div>
                <a href="~/Admin/Categories/ManageCategories.aspx" runat="server" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded text-slate-300 hover:bg-[#1E293B] hover:text-white transition-colors">
                    <i class="fa-solid fa-diagram-project w-4 text-center text-purple-400"></i> Categories &amp; Machines
                </a>
                <a href="~/Admin/SpareParts/ManageParts.aspx" runat="server" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded text-slate-300 hover:bg-[#1E293B] hover:text-white transition-colors">
                    <i class="fa-solid fa-boxes-stacked w-4 text-center text-orange-400"></i> Master Parts Catalog
                </a>

                <!-- Group 4: Operations & Audit -->
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-3 mt-4 mb-1 font-mono">Operations &amp; Security</div>
                <a href="~/Admin/Orders/Oversight.aspx" runat="server" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded text-slate-300 hover:bg-[#1E293B] hover:text-white transition-colors">
                    <i class="fa-solid fa-truck-fast w-4 text-center text-emerald-400"></i> Orders &amp; Emergency SOS
                </a>
                <a href="~/Admin/Audit/AuditLogs.aspx" runat="server" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded text-slate-300 hover:bg-[#1E293B] hover:text-white transition-colors">
                    <i class="fa-solid fa-clipboard-check w-4 text-center text-rose-400"></i> Platform Audit Trail
                </a>
            </nav>

            <!-- Admin Profile Footbar -->
            <div class="p-3.5 border-t border-slate-800 bg-[#0B1120] flex items-center justify-between text-left">
                <div class="flex items-center gap-2.5 overflow-hidden">
                    <div class="w-8 h-8 rounded bg-slate-700 text-white font-bold text-xs flex items-center justify-center shrink-0 border border-slate-600 font-mono">
                        SA
                    </div>
                    <div class="truncate">
                        <span class="text-xs font-bold text-white block truncate" id="lblAdminName" runat="server">Superadmin</span>
                        <span class="text-[10px] font-mono text-[#38BDF8] block">SUPERADMINISTRATOR</span>
                    </div>
                </div>
                <a href="~/Account/Logout.aspx" runat="server" class="text-slate-400 hover:text-red-400 transition-colors p-1.5" title="Sign Out">
                    <i class="fa-solid fa-right-from-bracket text-sm"></i>
                </a>
            </div>
        </aside>

        <!-- Main Content Viewport -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Top Admin Header -->
            <header class="h-16 bg-white border-b border-[#E2E8F0] px-6 lg:px-8 flex items-center justify-between shrink-0 shadow-xs">
                <div class="flex items-center gap-3 text-left">
                    <span class="text-xs font-bold font-mono uppercase text-[#64748B] tracking-wider">ASTANTRA GOVERNANCE</span>
                    <span class="text-[#CBD5E1]">/</span>
                    <h1 class="text-sm font-bold text-[#0F172A] m-0" id="lblPageHeader" runat="server">Console</h1>
                </div>
                <div class="flex items-center gap-4">
                    <a href="~/Default.aspx" runat="server" target="_blank" class="text-xs font-semibold text-[#1769E0] hover:underline flex items-center gap-1.5">
                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i> View Public Site
                    </a>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-[11px] font-mono font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> DB ENGINE ACTIVE
                    </span>
                </div>
            </header>

            <!-- Scrollable Page Content Area -->
            <main class="flex-1 overflow-y-auto p-6 lg:p-8 bg-[#F1F5F9]">
                <div class="admin-content-container">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </main>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
